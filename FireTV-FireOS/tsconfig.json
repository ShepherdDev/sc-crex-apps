{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    // Shared app code lives in ../TV-Shared (see metro.config.js).
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../TV-Shared/src/*"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    },
    "moduleSuffixes": [".android", ""]
  },
  "include": ["index.js", "src", "../TV-Shared/src", "../TV-Shared/test"],
  // Other platforms' versions of shared files (e.g. tv.kepler.ts).
  "exclude": [
    "**/node_modules",
    "../TV-Shared/src/**/*.kepler.ts",
    "../TV-Shared/src/**/*.kepler.tsx"
  ]
}
