{%- comment -%}
  GET /tv/watch?id=<IdKey>  (Crex "Video") -- the HLS URL of one published message.
  Only items whose channel type is 15 (the message types that carry HLSVideo) are served.
  Attribute Id 8888 = HLSVideo.  Enabled Lava Commands: Sql
{%- endcomment -%}
{%- assign itemId = QueryString.id | FromIdHash -%}
{%- if itemId == null or itemId == empty -%}
{ "Error": "Video not found." }
{%- else -%}
  {%- sql itemId:'{{ itemId }}' -%}
  SELECT H.[Value] AS [Url]
  FROM [ContentChannelItem] C
  INNER JOIN [ContentChannel] CH ON CH.[Id] = C.[ContentChannelId]
  INNER JOIN [AttributeValue] H ON H.[EntityId] = C.[Id] AND H.[AttributeId] = 8888
  WHERE C.[Id] = @itemId
    AND CH.[ContentChannelTypeId] = 15
    AND C.[StartDateTime] <= GETDATE()
  {%- endsql -%}
  {%- assign url = results | First | Property:'Url' -%}
  {%- if url == null or url == empty -%}
{ "Error": "Video not found." }
  {%- else -%}
{ "Template": "Video", "Data": {{ url | ToJSON }}, "IsLive": false, "RequiredCrexVersion": null }
  {%- endif -%}
{%- endif -%}
