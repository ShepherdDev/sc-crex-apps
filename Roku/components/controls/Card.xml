<?xml version="1.0" encoding="utf-8"?>
<!--
  A message or series card, used by RowList (Home) and MarkupGrid (series pages).
  Message cards show the title over a fade at the bottom of the art.
  Series cards are just the art. The list draws the focus ring.
-->
<component name="Card" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/lib/config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/format.brs" />
  <script type="text/brightscript" uri="pkg:/components/controls/Card.brs" />
  <children>
    <Rectangle id="placeholder" />
    <Poster id="art" loadDisplayMode="scaleToZoom" />
    <Poster id="fade" uri="pkg:/images/fade-down.png" visible="false" />
    <Label id="title" maxLines="2" wrap="true" vertAlign="bottom" />
    <Label id="meta" />
    <Label id="seeAll" horizAlign="center" vertAlign="center" visible="false" />
  </children>
</component>
