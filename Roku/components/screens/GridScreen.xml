<?xml version="1.0" encoding="utf-8"?>
<!--
  A grid page. Two uses:
    kind = "seriesList": a channel's series (Series, Life Groups, See All)
    kind = "series":     one series and its messages
-->
<component name="GridScreen" extends="Group">
  <interface>
    <field id="kind" type="string" />
    <field id="path" type="string" />
    <field id="heading" type="string" />
    <!-- Call after setting kind/path -->
    <field id="load" type="boolean" alwaysNotify="true" onChange="startLoad" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/lib/config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/format.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/content.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/GridScreen.brs" />
  <children>
    <Label id="title" translation="[472,88]" width="1360" />
    <Label id="subtitle" translation="[472,156]" width="1300" maxLines="2" wrap="true" />
    <Label id="status" translation="[472,300]" width="1100" wrap="true" />
    <MarkupGrid
      id="grid"
      translation="[472,240]"
      itemComponentName="Card"
      numColumns="4"
      numRows="4"
      itemSize="[326,183]"
      itemSpacing="[24,40]"
      vertFocusAnimationStyle="floatingFocus"
      focusBitmapUri="pkg:/images/focus-ring.9.png"
      focusFootprintBlendColor="0x00000000"
      visible="false" />
  </children>
</component>
